---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';

const routes = [
  { href: '/', label: 'Home', blurb: 'The front door.' },
  { href: '/work', label: 'Work', blurb: 'Ten projects, four companies.' },
  { href: '/writing', label: 'Writing', blurb: 'Posts on dev.to.' },
  { href: '/about', label: 'About', blurb: 'Who I am away from the keyboard.' },
];
---

<Base
  title="Page not found — Kazuhito Higashioka"
  description="That page doesn't exist. Here's everything that does."
>
  {/*
    A dead end should still answer the three wayfinding questions: where am I,
    where can I go, and what is there. A bare "404" answers none of them.
  */}
  <div class="flex flex-col items-start gap-10 py-12 md:flex-row md:items-center md:gap-14 md:py-20">
    <div class="flex-[1.7]">
      <p class="m-0 text-sm font-bold tracking-[0.16em] text-ink-muted uppercase">
        404
      </p>

      <h1 class="mt-3 text-4xl leading-[1.03] sm:text-5xl">
        This page <br />
        <span class="text-accent-deep">doesn't exist.</span>
      </h1>

      <p class="mt-5 max-w-(--spacing-prose) text-base leading-relaxed text-ink-muted">
        Either the link is old or I moved something. The whole site is four
        pages, so here is all of it.
      </p>

      <ul class="mt-8 grid list-none gap-3 p-0 sm:grid-cols-2">
        {routes.map(({ href, label, blurb }) => (
          <li>
            <a
              href={href}
              class="liftable group block rounded-(--radius-card) border border-border-warm bg-surface p-4 no-underline"
            >
              <span
                class="block font-display text-base font-bold text-ink transition-colors duration-(--duration-settle) ease-settle group-hover:text-accent-deep"
              >
                {label}
              </span>
              <span class="mt-1 block text-sm text-ink-muted">{blurb}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="flex flex-1 justify-center">
      <Mark />
    </div>
  </div>
</Base>
