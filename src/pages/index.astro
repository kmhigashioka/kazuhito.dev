---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import { profile } from '../content/profile';

const pages = [
  { href: '/work', label: 'See my work', primary: true },
  { href: '/writing', label: 'Writing', primary: false },
  { href: '/about', label: 'About me', primary: false },
];
---

<Base title={profile.name} description={profile.tagline}>
  <div class="flex flex-col items-start gap-10 py-10 md:flex-row md:items-center md:gap-14 md:py-16">
    <div class="flex-[1.7]">
      <h1 class="text-4xl leading-[1.03] sm:text-5xl">
        {/*
          The trailing spaces before each <br /> are load-bearing: without them
          the heading's text content runs together as "softwarefor humans" for
          anything reading it as a string rather than rendering it.
        */}
        Hi, I'm {profile.shortName}. <br />
        I build software <br />
        <span class="text-accent-deep">for humans.</span>
      </h1>

      <p class="mt-5 max-w-(--spacing-prose) text-base leading-relaxed text-ink-muted">
        {profile.tagline}
      </p>

      <div class="mt-8 flex flex-wrap gap-2.5">
        {pages.map(({ href, label, primary }) => (
          <a
            href={href}
            class:list={[
              'pressable inline-block rounded-full px-5 py-3 text-sm font-bold no-underline',
              'hover:shadow-lift',
              primary
                ? 'bg-ink text-paper hover:bg-ink/90'
                : 'border-[1.5px] border-border-warm bg-transparent text-ink hover:border-accent/45 hover:bg-surface',
            ]}
          >
            {label}
          </a>
        ))}
      </div>

      <ul class="mt-6 flex list-none flex-wrap gap-4 p-0 text-sm">
        {profile.links.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class="pressable group relative inline-block font-semibold text-accent-deep no-underline"
            >
              {label}
              <span
                aria-hidden="true"
                class="absolute -bottom-0.5 left-0 h-px w-full origin-left scale-x-0 rounded-full bg-accent-deep transition-transform duration-(--duration-settle) ease-settle group-hover:scale-x-100"
              ></span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="flex flex-1 justify-center">
      <Mark />
    </div>
  </div>
</Base>
