---
import { Image } from 'astro:assets';
import type { Project } from '../content/types';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

{/*
  The lift and the whole-card hit target are conditional on there being a link.
  A card that responds to hover but does nothing when clicked is a lie about
  what is interactive, and users only have to be caught by it once.
*/}
<article
  class:list={[
    'relative flex h-full flex-col rounded-(--radius-card) border border-border-warm bg-surface p-5',
    project.link && 'liftable group',
  ]}
>
  {/*
    2:1 with the crop anchored to the top. Native ratios run 1.34–2.03, so
    this trims from the bottom of each and keeps every app's header and nav —
    the part that makes a product recognisable. The previous slot was 56px
    tall, at which a Storybook screenshot is an illegible smear.

    alt="" is deliberate: a UI screenshot cannot be conveyed in an alt string,
    and the title and blurb below say what the project is.
  */}
  {project.image && (
    <Image
      src={project.image}
      alt=""
      loading="lazy"
      widths={[470, 940]}
      sizes="(min-width: 640px) 470px, 100vw"
      class="mb-4 aspect-[2/1] w-full rounded-lg object-cover object-top"
    />
  )}

  <h3 class="text-lg">
    {project.link ? (
      <a
        href={project.link}
        class="stretch-target text-ink underline decoration-border-warm underline-offset-4 transition-colors duration-(--duration-settle) ease-settle group-hover:text-accent-deep group-hover:decoration-accent-deep"
      >
        {project.title}
      </a>
    ) : (
      project.title
    )}
  </h3>

  <p class="mt-1.5 text-sm leading-relaxed text-ink-muted">{project.blurb}</p>

  {/*
    Pushed to the bottom so the tech rows land on one line across the grid row
    regardless of how long each blurb runs. Misaligned baselines between
    side-by-side cards read as breakage, not as variety.
  */}
  <ul class="mt-auto flex list-none flex-wrap gap-1.5 p-0 pt-4">
    {project.tech.map((tech) => (
      <li class="rounded-full border border-border-warm px-2.5 py-1 text-xs font-semibold text-ink-muted">
        {tech}
      </li>
    ))}
  </ul>
</article>
